[Unit]
Description=OpenClaw Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openclaw_user }}
Group={{ openclaw_group }}
Environment=OPENCLAW_CONFIG_PATH={{ openclaw_config_path }}
Environment=OPENCLAW_STATE_DIR={{ openclaw_state_dir }}
Environment=GOPATH={{ openclaw_home }}/go
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:{{ openclaw_home }}/go/bin
{% for k, v in openclaw_skills_env.items() %}
Environment={{ k }}={{ v }}
{% endfor %}
WorkingDirectory={{ openclaw_home }}
ExecStart={{ openclaw_bin_path }} gateway --port {{ openclaw_gateway_port }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
